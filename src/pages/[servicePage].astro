---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
import ContactLink from '../components/ContactLink.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
export function getStaticPaths() {
  return site.services.length ? [{ params: { servicePage: 'banho-e-tosa' } }] : [];
}
---
<Base title={`Banho e tosa em ${site.city} | ${site.name}`} description={`Entenda banho, tosa e tosa higiênica, o que informar antes da visita e como consultar valores. ${site.name}${site.demo ? ': demonstração comercial' : ''} em ${site.city}.`}>
  <section class="service-hero"><div class="container"><Breadcrumbs label="Serviços" /><div class="service-hero-grid"><div><h1>Banho e tosa para o seu pet.</h1><p class="page-intro">Da limpeza da pelagem ao corte: conheça cada cuidado e o que combinar antes do atendimento.</p><ContactLink subject="banho e tosa" />{site.demo && <p class="demo-inline-note">Serviços ilustrativos. Esta demonstração não recebe pets nem confirma agendamentos.</p>}</div><div class="service-hero-visual" aria-hidden="true"><img src={site.images.hero} srcset={site.images.heroWebp} sizes="360px" width="1000" height="1000" alt="" fetchpriority="high" /></div></div></div></section>
  <section class="service-detail-section section-space"><div class="container">{site.services.map(service => <article class="service-detail" id={service.id}><div class="service-detail-name"><Icon name={service.icon} size={45} /><h2>{service.name}</h2></div><div><p class="detail-lead">{service.description}</p><p>{service.detail}</p><ContactLink subject={service.name.toLowerCase()} variant="text">Consultar {service.name.toLowerCase()}</ContactLink></div></article>)}</div></section>
  <section class="container service-pricing"><div><h2>Como o valor é definido?</h2><p>O orçamento considera o serviço escolhido e as características do pet. Antes de confirmar, consulte o que está incluído e o tempo estimado.</p></div><ul><li><strong>Porte</strong><span>O tamanho do animal.</span></li><li><strong>Pelagem</strong><span>Tipo, comprimento e condição dos pelos.</span></li><li><strong>Necessidades</strong><span>Cuidados a combinar com o tutor.</span></li></ul></section>
  <section class="preparation"><div class="container preparation-grid"><div><p class="eyebrow">ANTES DE SAIR DE CASA</p><h2>Uma visita mais<br />tranquila começa aqui.</h2></div><ul><li>Informe sensibilidades, comportamento e orientações veterinárias.</li><li>Confirme o serviço, o valor e o horário antes da visita.</li><li>Use guia ou transporte adequado para chegar com seu pet.</li><li>Converse sobre o tempo estimado e como será avisado ao final.</li></ul></div></section>
  <section class="container page-end"><div><h2>Antes da visita</h2><p>Veja as dúvidas frequentes sobre o atendimento.</p></div><a class="text-link" href="/perguntas-frequentes/">Perguntas frequentes <Icon name="arrow" /></a></section>
</Base>
