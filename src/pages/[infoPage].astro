---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactLink from '../components/ContactLink.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { site, infoPages, hasServices, hasProducts } from '../data/site';
export function getStaticPaths() {
  return infoPages.map(page => ({ params: { infoPage: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<Base title={`${page.label} | ${site.name} em ${site.city}`} description={`${page.intro} ${site.demo ? 'Demonstração comercial Ghati.' : ''}`}>
  <section class:list={['page-hero', `page-hero--${page.slug}`]}><div class="container"><Breadcrumbs label={page.label} /><p class="eyebrow">{page.label} · {site.city}</p><h1>{page.title}</h1><p class="page-intro">{page.intro}</p></div></section>

  {page.slug === 'quem-somos' && <>
    <section class="about-section"><div class="container about-grid"><figure class="about-photo"><img src={site.images.companion} srcset={`${site.images.companionSmall} 400w, ${site.images.companion} 800w`} sizes="(max-width: 600px) calc(100vw - 40px), 50vw" alt="Dois cães em um passeio ao ar livre, fotografia ilustrativa" width="800" height="900" loading="lazy" /><figcaption>Companhia para os momentos de todo dia.<br /><span>Fotografia ilustrativa.</span></figcaption></figure><div class="about-copy"><p class="eyebrow">NOSSO JEITO DE CUIDAR</p><h2>{site.about.title}</h2><p class="about-description">{site.about.description}</p><div class="principles">{site.about.principles.map(principle => <article><h3>{principle.title}</h3><p>{principle.text}</p></article>)}</div></div></div></section>
    <section class="container section-space"><div class="section-heading"><h2>Conheça o que<br />faz parte do Pátio.</h2><p class="section-intro">Cuidados com a pelagem, itens do dia a dia e informação para escolher com calma.</p></div><div class="related-links">{hasServices && <a href="/banho-e-tosa/">Conhecer os serviços <Icon name="arrow" /></a>}{hasProducts && <a href="/loja/">Conhecer a loja <Icon name="arrow" /></a>}<a href="/contato/">{site.demo ? 'Sobre esta demonstração' : 'Falar com a gente'} <Icon name="arrow" /></a></div>{site.demo && <p class="demo-inline-note about-demo-note">O Pátio Pet é um conceito criado pela Ghati. As imagens são ilustrativas e não representam uma loja, uma equipe ou animais atendidos.</p>}</section>
  </>}

  {page.slug === 'loja' && <>
    <section class="products-section section-space"><div class="container"><h2>O cuidado continua em casa.</h2><p class="catalog-intro">{site.demo ? 'Categorias e itens ilustrativos para mostrar a variedade de um pet shop. Não há venda online ou estoque disponível nesta demonstração.' : 'Conheça as categorias. Consulte marcas, tamanhos, preços e disponibilidade com a equipe.'}</p><div class="product-list">{site.products.map(product => <article><div class="category-visual" aria-hidden="true"><Icon name={product.icon} size={84} /></div><h3>{product.name}</h3><p>{product.description}</p><ul class="category-examples">{product.examples.map(example => <li>{example}</li>)}</ul><p class="category-guidance">{product.guidance}</p><ContactLink subject={product.name.toLowerCase()} variant="text">Consultar {product.name.toLowerCase()}</ContactLink></article>)}</div></div></section>
    <section class="preparation"><div class="container preparation-grid"><div><p class="eyebrow">SEM COMPLICAÇÃO</p><h2>Procurando algo específico?</h2><p class="section-intro">Mande o nome ou uma foto do produto. A conversa ajuda a encontrar a opção que faz sentido para a sua rotina.</p></div><div><ol class="steps-list"><li><span>01</span><div><h3>Conte o que procura</h3><p>Informe o item, a marca ou o tamanho desejado.</p></div></li><li><span>02</span><div><h3>Confirme os detalhes</h3><p>Consulte preço e disponibilidade antes de ir à loja.</p></div></li><li><span>03</span><div><h3>Combine a visita</h3><p>Confira o endereço e o horário de atendimento.</p></div></li></ol><ContactLink subject="produtos da loja">Consultar um produto</ContactLink></div></div></section>
    <div class="container page-end"><p>O site apresenta categorias. Marcas, preços e estoque são consultados diretamente na conversa.</p><a class="text-link" href="/perguntas-frequentes/">Dúvidas sobre a loja <Icon name="arrow" /></a></div>
  </>}

  {page.slug === 'perguntas-frequentes' && <><div class="container faq-shortcuts" aria-label="Assuntos das perguntas">{hasServices && <a href="#faq-services">Banho e tosa <Icon name="arrow" size={18} /></a>}{hasProducts && <a href="#faq-products">Loja e produtos <Icon name="arrow" size={18} /></a>}<a href="#faq-general">{site.demo ? 'Contato e demonstração' : 'Contato'} <Icon name="arrow" size={18} /></a></div><Faq /><section class="container page-end"><div><h2>Ficou alguma dúvida?</h2><p>{site.demo ? 'Fale com a Ghati sobre a demonstração ou sobre um site para o seu negócio.' : 'Conte o que procura e continue a conversa com a equipe.'}</p></div><ContactLink commercial={site.demo}>{site.demo ? 'Falar com a Ghati' : 'Falar pelo WhatsApp'}</ContactLink></section></>}

  {page.slug === 'contato' && <>
    <section class="contact-page section-space"><div class="container contact-page-grid"><div class:list={['contact-main', {'contact-main--commercial': site.demo}]}><Icon name="whatsapp" size={42} /><h2>{site.demo ? 'Ghati Inovações' : 'Um olá já é um começo.'}</h2><p>{site.demo ? 'Um espaço próprio para apresentar seu pet shop. Conte como é o seu negócio e quais serviços você quer mostrar.' : 'Conte sobre seu pet ou sobre o produto que procura. Vamos combinar os próximos passos.'}</p><ContactLink commercial={site.demo} variant={site.demo ? 'light' : 'primary'}>{site.demo ? 'Quero um site assim' : 'Conversar pelo WhatsApp'}</ContactLink><a class="phone-link" href={`tel:+${site.demo ? site.demoPhone : site.businessPhone}`} aria-label={`${site.demo ? 'Ligar para a Ghati: ' : 'Ligar: '}${site.demo ? site.demoPhoneLabel : site.businessPhone}`}>{site.demo ? site.demoPhoneLabel : site.businessPhone}</a>{site.demo && <p class="contact-business-note">WhatsApp e telefone comerciais da Ghati. Nenhuma mensagem é enviada automaticamente.</p>}</div><div class="local-information"><article><Icon name="pin" size={28} /><h2>{site.demo ? 'Localização do exemplo' : 'Onde estamos'}</h2><p><strong>{site.city}, {site.state}</strong></p><p>{site.demo ? 'Praia Grande é o cenário deste demonstrativo. O Pátio Pet não tem loja física ou endereço para visita.' : `${site.address} · ${site.neighborhood} · CEP ${site.postalCode}`}</p>{!site.demo && site.mapsUrl && <a class="text-link" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Ver rota no Google Maps ↗</a>}</article><article><Icon name="sun" size={28} /><h2>{site.demo ? 'Atendimento para pets' : 'Horário de atendimento'}</h2><p>{site.demo ? 'Não há horários, agendamentos ou venda de produtos nesta demonstração. Em um site real, esta área reúne os horários confirmados do pet shop.' : site.hoursLabel}</p></article>{site.demo ? <article><h2>Redes e localização</h2><p>Não há Instagram ou perfil no Maps do Pátio Pet. Os links de um cliente são incluídos após a confirmação dos dados reais.</p></article> : site.socialUrl && <a class="text-link" href={site.socialUrl} target="_blank" rel="noopener noreferrer">Encontre a gente no Instagram ↗</a>}</div></div></section>
    <section class="preparation"><div class="container preparation-grid"><div><h2>{site.demo ? 'O seu negócio é o ponto de partida.' : 'Já sabe qual cuidado procura?'}</h2></div><div><p class="section-intro">{site.demo ? 'Na primeira conversa, conte o nome do pet shop, onde ele fica e o que oferece. A partir disso, a Ghati pode entender o conteúdo que seu site precisa apresentar.' : 'Informe o serviço, o porte e a pelagem do seu pet. Isso ajuda a consultar as opções antes da visita.'}</p>{hasServices && <a class="text-link" href="/banho-e-tosa/">Ver os serviços <Icon name="arrow" /></a>}<a class="text-link" href="/perguntas-frequentes/">Consultar as dúvidas frequentes <Icon name="arrow" /></a></div></div></section>
  </>}
</Base>
