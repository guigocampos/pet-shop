---
import Base from '../layouts/Base.astro';
import { site, hasServices, hasProducts } from '../data/site';
import Icon from '../components/Icon.astro';
import ContactLink from '../components/ContactLink.astro';
const heroSizes = '(max-width: 600px) 440px, (max-width: 800px) 520px, 706px';
const offerTitle = hasServices ? 'Banho, tosa e cuidados' : 'Essenciais para seu pet';
const offerDescription = hasServices ? (hasProducts ? 'banho, tosa e produtos para a rotina do pet' : 'banho e tosa para a rotina do pet') : 'produtos para a rotina do pet';
---
<Base title={`${site.name} | ${offerTitle} em ${site.city}`} description={`Conheça ${offerDescription} no ${site.name} em ${site.city}, ${site.state}. ${site.demo ? 'Demonstração comercial Ghati.' : 'Consulte disponibilidade pelo WhatsApp.'}`}>
  <section class="hero"><div class="container hero-inner">
    <div class="hero-copy"><p class="eyebrow location-label"><Icon name="pin" size={18} /> PET SHOP EM {site.city.toUpperCase()}</p><h1>{site.hero.title}</h1><p class="hero-description">{site.hero.description}</p><ContactLink subject={hasServices ? 'banho e tosa' : 'produtos da loja'}>Falar pelo WhatsApp</ContactLink><a class="hero-secondary" href={hasServices ? '/banho-e-tosa/' : '/loja/'}>{hasServices ? 'Conhecer os serviços' : 'Conhecer a loja'} <Icon name="arrow" size={20} /></a></div>
    <div class="hero-art"><div class="hero-arch" aria-hidden="true"></div><picture><source type="image/avif" srcset={site.images.heroAvif} sizes={heroSizes} /><img class="hero-dog" src={site.images.hero} srcset={site.images.heroWebp} sizes={heroSizes} width="1000" height="1000" alt="Golden retriever com bandana azul-petróleo, imagem ilustrativa" fetchpriority="high" /></picture><div class="hero-note" aria-hidden="true"><Icon name="sun" size={36} /><span>Bom para eles.<br />Bom para você.</span></div></div>
  </div></section>
  <div class="care-ribbon"><div class="container"><span>{hasServices ? 'Banho & tosa' : 'Essenciais para seu pet'}</span><Icon name="sun" size={18} /><span>Cuidado no dia a dia</span><Icon name="sun" size={18} /><span>Por perto, em {site.city}</span></div></div>
  {site.sections.about && <section class="welcome-section container section-space"><p class="eyebrow">BEM-VINDO AO PÁTIO</p><div class="welcome-grid"><h2>Cada pet tem seu jeito.<br />Aqui, a conversa tem espaço.</h2><div><p>{site.about.description}</p><a class="text-link" href="/quem-somos/">Conheça o Pátio Pet <Icon name="arrow" /></a></div></div></section>}
  {hasServices && <section id="cuidados" class="services-section section-space"><div class="container"><div class="section-heading"><div><p class="eyebrow">NOSSOS SERVIÇOS</p><h2>Um cuidado<br />para cada pelagem.</h2></div><a class="text-link" href="/banho-e-tosa/">Todos os serviços <Icon name="arrow" /></a></div><div class="service-list">{site.services.map(service => <a class="service-row" href={`/banho-e-tosa/#${service.id}`}><span class="service-icon"><Icon name={service.icon} size={38} /></span><div class="service-title"><h3>{service.name}</h3></div><p>{service.short}</p><span class="service-arrow" aria-hidden="true"><Icon name="arrow" /></span></a>)}</div></div></section>}
  {hasProducts && <section id="na-loja" class="shop-preview"><div class="container shop-preview-grid"><div><p class="eyebrow">NA LOJA</p><h2>Para os bons<br />momentos de todo dia.</h2><p>Alimentação, acessórios e higiene para acompanhar a rotina do seu pet.</p><a class="text-link" href="/loja/">Conheça as categorias <Icon name="arrow" /></a></div><div class="shop-symbols" aria-hidden="true"><Icon name="bowl" size={70} /><Icon name="ball" size={70} /><Icon name="bottle" size={70} /></div></div></section>}
  <section class="container home-guide section-space"><p class="eyebrow">PODE CHEGAR</p><div class="guide-links"><a href="/perguntas-frequentes/"><div><h2>Uma dúvida antes da visita?</h2><p>Encontre as respostas sobre cuidados e consultas.</p></div><Icon name="arrow" size={30} /></a><a href="/contato/"><div><h2>Vamos conversar?</h2><p>Veja como falar com a gente e planejar o próximo passo.</p></div><Icon name="arrow" size={30} /></a></div></section>
</Base>
