---
import { site, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';
interface Props { subject?: string; variant?: 'primary' | 'light' | 'text'; commercial?: boolean; class?: string; }
const { subject = '', variant = 'primary', commercial = false, class: className = '' } = Astro.props;
---
<a class:list={['contact-link', `contact-link--${variant}`, className]} href={whatsappUrl(subject)} target="_blank" rel="noopener noreferrer">
  <span class="contact-label"><slot>Consultar pelo WhatsApp</slot>{site.demo && !commercial && <small class="contact-destination">Demo · WhatsApp da Ghati</small>}</span><Icon name="arrow" size={20} />
  <span class="sr-only"> (abre o WhatsApp em nova aba)</span>
</a>
